                <mxCell id="micro-detail-53" edge="1" parent="1" source="micro-detail-37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" target="micro-detail-5" value="HTTP / СМЭВ (после MVP)">
