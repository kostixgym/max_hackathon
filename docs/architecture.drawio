                <mxCell id="mono-detail-67" edge="1" parent="1" source="mono-detail-63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" target="mono-detail-64" value="">
