                <mxCell id="micro-detail-54" parent="1" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" value="B. Как проходит один голос: цепочка событий" vertex="1">
                    <mxGeometry height="330" width="1720" x="40" y="850" as="geometry"/>
                </mxCell>
                <mxCell id="micro-detail-55" parent="micro-detail-54" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;1. Bot Gateway&lt;/b&gt;&lt;br&gt;получил нажатие «Поддерживаю»&lt;br&gt;→ публикует VoteRequested" vertex="1">
                    <mxGeometry height="100" width="300" x="30" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="micro-detail-56" parent="micro-detail-54" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;2. Voting&lt;/b&gt;&lt;br&gt;«собственник?» — по локальной копии ролей&lt;br&gt;(собрана из событий MembershipVerified)" vertex="1">
                    <mxGeometry height="100" width="300" x="370" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="micro-detail-57" parent="micro-detail-54" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;3. Voting&lt;/b&gt;&lt;br&gt;записывает голос в свою БД&lt;br&gt;→ публикует VoteCast" vertex="1">
                    <mxGeometry height="100" width="300" x="710" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="micro-detail-58" parent="micro-detail-54" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;4. Initiative&lt;/b&gt;&lt;br&gt;получает VoteCast,&lt;br&gt;пересчитывает прогноз в м²" vertex="1">
                    <mxGeometry height="100" width="300" x="1050" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="micro-detail-59" parent="micro-detail-54" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;5. Notification&lt;/b&gt;&lt;br&gt;тоже получает VoteCast,&lt;br&gt;отправляет «Голос учтён»" vertex="1">
                    <mxGeometry height="100" width="300" x="1390" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="micro-detail-64" parent="micro-detail-54" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;Отставание копии ролей&lt;/b&gt;&lt;br&gt;подтверждение ещё не дошло →&lt;br&gt;голос отклонён или принят зря" vertex="1">
                    <mxGeometry height="90" width="400" x="30" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="micro-detail-65" parent="micro-detail-54" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;Повторы и порядок событий&lt;/b&gt;&lt;br&gt;событие может прийти дважды →&lt;br&gt;нужна идемпотентность" vertex="1">
                    <mxGeometry height="90" width="400" x="450" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="micro-detail-66" parent="micro-detail-54" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;Итог в нескольких БД&lt;/b&gt;&lt;br&gt;голоса, роли и площади в разных сервисах →&lt;br&gt;нужна сверка при подсчёте" vertex="1">
                    <mxGeometry height="90" width="400" x="870" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="micro-detail-67" parent="micro-detail-54" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;Отладка&lt;/b&gt;&lt;br&gt;один голос проходит 4 сервиса →&lt;br&gt;без трассировки не разобраться" vertex="1">
                    <mxGeometry height="90" width="400" x="1290" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="micro-detail-60" edge="1" parent="1" source="micro-detail-55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" target="micro-detail-56" value="VoteRequested">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="micro-detail-61" edge="1" parent="1" source="micro-detail-56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" target="micro-detail-57" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="micro-detail-62" edge="1" parent="1" source="micro-detail-57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" target="micro-detail-58" value="VoteCast">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="micro-detail-63" edge="1" parent="1" source="micro-detail-58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" target="micro-detail-59" value="VoteCast">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="micro-detail-68" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Плюсы&lt;/b&gt;&lt;br&gt;• каждый сервис масштабируется отдельно (например, только Notification в пики рассылок)&lt;br&gt;• независимые релизы и отдельные команды на каждую область&lt;br&gt;• сбой одного сервиса (например, Documents) не мешает голосовать&lt;br&gt;• границы данных навязаны инфраструктурой: в чужую БД не залезть&lt;br&gt;• под задачу можно выбрать свою технологию" vertex="1">
                    <mxGeometry height="200" width="850" x="40" y="1220" as="geometry"/>
                </mxCell>
                <mxCell id="micro-detail-69" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Минусы&lt;/b&gt;&lt;br&gt;• 8+ сервисов, брокер, 7+ хранилищ: на хакатоне время уйдёт на инфраструктуру&lt;br&gt;• распределённая согласованность: голос, роль и прогноз в разных базах&lt;br&gt;• сложно тестировать и отлаживать сценарий целиком&lt;br&gt;• тяжёлый запуск для жюри, риск не уложиться в 5 минут сборки&lt;br&gt;• дорогая эксплуатация: мониторинг, трассировка, версии контрактов&lt;br&gt;• критерий хакатона «соответствие масштабу MVP» играет против" vertex="1">
                    <mxGeometry height="200" width="850" x="910" y="1220" as="geometry"/>
                </mxCell>
                <mxCell id="micro-detail-70" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Когда оправдано:&lt;/b&gt; десятки регионов и тысячи УК; отдельные команды на уведомления, интеграции и голосование; пиковые рассылки на миллионы сообщений; разные требования к доступности частей системы. Путь туда — выносить из монолита по одному модулю по мере появления реальной причины (вкладка 7)." vertex="1">
                    <mxGeometry height="80" width="1720" x="40" y="1440" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
