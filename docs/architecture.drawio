                <mxCell id="mono-detail-68" edge="1" parent="1" source="mono-detail-64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" target="mono-detail-65" value="">
