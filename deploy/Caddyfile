# Caddy: the only public entry point.
#   /api/*   → backend (app:8080)
#   the rest → static files of the mini-app
#
# SITE_ADDRESS:
#   :80            — local run, plain HTTP (default)
#   dom.example.ru — server: Caddy gets a TLS certificate automatically (ports 80 and 443 must be open).
#                    The mini-app in MAX works only over HTTPS.

{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy app:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# No X-Frame-Options: MAX opens the mini-app inside its own client.
}
