# Copy to .env and fill in: cp .env.example .env
# .env is ignored by git. Never commit real tokens, passwords or keys.

# ---------------------------------------------------------------- docker compose
# Password of the PostgreSQL user "app" (compose builds DATABASE_URL from it).
POSTGRES_PASSWORD=change-me-local-password
# Ports of the web entry point (Caddy) on the host.
HTTP_PORT=8080
HTTPS_PORT=8443
# :80 — local run over HTTP. On a server — the domain (dom.example.ru): Caddy gets HTTPS automatically;
# then publish ports 80 and 443 (HTTP_PORT=80, HTTPS_PORT=443).
SITE_ADDRESS=:80

# ---------------------------------------------------------------- MAX
# Bot token from the organizers. Put the real value only into .env or deployment secrets.
MAX_BOT_TOKEN=
# How long a mini-app launch (initData auth_date) stays valid.
INITDATA_MAX_AGE=24h

# ---------------------------------------------------------------- personal data
# HMAC key for phone and personal account numbers: at least 32 random bytes,
# e.g. `openssl rand -hex 32`. Never reuse MAX_BOT_TOKEN. Changing it breaks matching
# with already stored hashes until the next registry upload.
HMAC_SECRET=

# ---------------------------------------------------------------- development
# true accepts requests without initData (X-Dev-User-Id header). Only for local runs
# without MAX; must be false on any server reachable by real users.
DEV_MODE=false

# ---------------------------------------------------------------- mailings
# Quiet hours 22:00–09:00 by the time of the house: poll invitations, poll results and
# questions wait for the morning. false sends them at once (testing in the evening).
QUIET_HOURS=true

# ---------------------------------------------------------------- demo data
# Synthetic demo house (60 flats + a shop, 3 000 м²) for the jury.
SEED_DEMO=true
# Fixed invite slug of the demo house, so the link in README and on the slide never changes.
# Empty = random, printed to the log on the first start. Allowed: [A-Za-z0-9_-].
DEMO_INVITE_SLUG=

LOG_LEVEL=info

# ---------------------------------------------------------------- running the backend without docker
# Used only by `go run ./cmd/app`; in compose DATABASE_URL and HTTP_ADDR are set by compose.yaml.
DATABASE_URL=postgres://app:change-me-local-password@localhost:5432/app?sslmode=disable
HTTP_ADDR=:8080
