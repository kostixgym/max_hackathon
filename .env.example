# HTTP
HTTP_ADDR=:8080
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/maxhackathon?sslmode=disable

# MAX
# Put the real token only in the ignored .env file or in deployment secrets.
MAX_BOT_TOKEN=
INITDATA_MAX_AGE=24h

# Personal-data HMAC key: at least 32 random bytes. Never reuse MAX_BOT_TOKEN.
HMAC_SECRET=

# Local development only. Must be false on a publicly reachable server.
DEV_MODE=true

# Synthetic jury/demo data
SEED_DEMO=true
DEMO_INVITE_SLUG=
